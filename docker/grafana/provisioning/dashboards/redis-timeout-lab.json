{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": []
  },
  "description": "Redis 타임아웃 원인 판별 — JVM/CPU 포화(범인) vs Redis 서버(무죄) 비교",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "앱 (JVM/CPU) — 범인 후보",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "process_cpu_usage: JVM 프로세스 CPU. ~1.0 = 2코어 100% 포화. 타임아웃 유발 시 이 값이 치솟아야 한다.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "max": 1.1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "process_cpu_usage{job=\"lab-redis-app\"}",
          "legendFormat": "JVM CPU (≈1.0 = 2코어 포화)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "system_cpu_usage{job=\"lab-redis-app\"}",
          "legendFormat": "System CPU",
          "refId": "B"
        }
      ],
      "title": "CPU 사용률 (process / system)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "살아있는 JVM 스레드 수. CPU 포화 시 스레드 수도 급증한다.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "jvm_threads_live_threads{job=\"lab-redis-app\"}",
          "legendFormat": "Live Threads",
          "refId": "A"
        }
      ],
      "title": "JVM Live Threads",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "GC pause 발생률 (회/초). CPU 포화 동반 시 GC도 증가한다.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(jvm_gc_pause_seconds_count{job=\"lab-redis-app\"}[1m]))",
          "legendFormat": "GC pause rate (회/초)",
          "refId": "A"
        }
      ],
      "title": "JVM GC Pause Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "HTTP 응답 최대 지연 (max, 1분 window). 버킷 메트릭이 없으므로 _max 사용. 타임아웃 시 수백ms→수초 급등.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(http_server_requests_seconds_max{job=\"lab-redis-app\", uri=\"/api/catalog\"})",
          "legendFormat": "/api/catalog max latency",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"lab-redis-app\", uri=\"/api/catalog\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"lab-redis-app\", uri=\"/api/catalog\"}[1m]))",
          "legendFormat": "/api/catalog avg latency",
          "refId": "B"
        }
      ],
      "title": "HTTP /api/catalog 응답 지연 (max / avg)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "HTTP 500 에러 발생률. 타임아웃 = RedisCommandTimeoutException → 500. L1=off 고부하 시 급등해야 한다.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "lineWidth": 2 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"lab-redis-app\", status=\"500\"}[1m]))",
          "legendFormat": "HTTP 500 rate (req/s)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"lab-redis-app\", status=\"200\"}[1m]))",
          "legendFormat": "HTTP 200 rate (req/s)",
          "refId": "B"
        }
      ],
      "title": "HTTP 에러율 — 500 급등 = JVM 범인 확정",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Lettuce 커맨드 완료 지연 (max). EventLoop 가 굶으면 GET 명령 완료가 수백ms로 늘어난다.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (command) (lettuce_command_completion_seconds_max{job=\"lab-redis-app\"})",
          "legendFormat": "completion max — {{command}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (command) (lettuce_command_firstresponse_seconds_max{job=\"lab-redis-app\"})",
          "legendFormat": "firstresponse max — {{command}}",
          "refId": "B"
        }
      ],
      "title": "Lettuce 커맨드 지연 (max)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 101,
      "title": "Redis (서버측) — 무죄 입증",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Redis 서버 CPU (sys+user). JVM 타임아웃이 발생해도 Redis 측 CPU는 낮아야 한다 — 이것이 \"Redis 무죄\" 증거.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(redis_cpu_sys_seconds_total{job=\"redis-exporter\"}[1m]) + rate(redis_cpu_user_seconds_total{job=\"redis-exporter\"}[1m])",
          "legendFormat": "Redis CPU (sys+user)",
          "refId": "A"
        }
      ],
      "title": "Redis CPU 사용률 — 낮으면 Redis 무죄",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "slowlog 길이. Redis 내부가 느리면 올라간다. 타임아웃이 JVM 문제라면 여기는 0이어야 한다.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": { "lineWidth": 2 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "redis_slowlog_length{job=\"redis-exporter\"}",
          "legendFormat": "Slowlog 길이",
          "refId": "A"
        }
      ],
      "title": "Redis Slowlog 길이 — 0이면 Redis 무죄",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Redis 초당 처리 커맨드 수. 정상적으로 올라가면 Redis 자체는 잘 동작 중.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "id": 9,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(redis_commands_processed_total{job=\"redis-exporter\"}[1m])",
          "legendFormat": "Redis ops/sec",
          "refId": "A"
        }
      ],
      "title": "Redis Ops/sec",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Redis 연결 클라이언트 수.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "redis_connected_clients{job=\"redis-exporter\"}",
          "legendFormat": "Connected Clients",
          "refId": "A"
        }
      ],
      "title": "Redis Connected Clients",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Redis 메모리 사용량 (bytes). 596KB 오브젝트가 캐시되므로 기준선 이상 사용.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 11,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "redis_memory_used_bytes{job=\"redis-exporter\"}",
          "legendFormat": "Memory Used",
          "refId": "A"
        }
      ],
      "title": "Redis Memory Used",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["redis", "jvm", "lab"],
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Redis Timeout Lab — JVM vs Redis",
  "uid": "redis-timeout-lab",
  "version": 1
}
